# Hi nova 9 Pro (TINA-AN00) - TWRP recovery fstab
# Derived from the stock first-stage fstab (vendor_boot fstab.default) and the
# super LP metadata (system, hw_product, cust, vendor, odm).
# The stock recovery.fstab inside recovery.img is a generic QCOM template and
# does not match this device, so it is not used.

#<src>                                   <mnt_point>        <type>  <mnt_flags and options>                                  <fs_mgr_flags>
system                                   /system_root       ext4    ro,barrier=1,discard                                     wait,logical,first_stage_mount
hw_product                               /hw_product        ext4    ro,barrier=1,discard                                     wait,logical,first_stage_mount
vendor                                   /vendor            ext4    ro,barrier=1,discard                                     wait,logical,first_stage_mount
odm                                      /odm               ext4    ro,barrier=1,discard                                     wait,logical,first_stage_mount
cust                                     /cust              ext4    ro,barrier=1,discard                                     wait,logical,first_stage_mount

/dev/block/bootdevice/by-name/metadata   /metadata          ext4    noatime,nosuid,nodev,discard                             wait,check,formattable,wrappedkey,first_stage_mount
/dev/block/bootdevice/by-name/userdata   /data              f2fs    noatime,nosuid,nodev,discard,fsync_mode=nobarrier,inline_data,inline_xattr,inlinecrypt   latemount,wait,check,quota,reservedsize=128M,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized+wrappedkey_v0,keydirectory=/metadata/vold/metadata_encryption,metadata_encryption=aes-256-xts:wrappedkey_v0
/dev/block/bootdevice/by-name/cache      /cache             ext4    nosuid,noatime,nodev,barrier=1                           wait
/dev/block/bootdevice/by-name/persist    /mnt/vendor/persist ext4   noatime,nosuid,nodev,barrier=1                           wait
/dev/block/bootdevice/by-name/modem      /firmware          vfat    ro,shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337,context=u:object_r:firmware_file:s0   wait
/dev/block/bootdevice/by-name/bluetooth  /bt_firmware       vfat    ro,shortname=lower,uid=1002,gid=3002,dmask=227,fmask=337,context=u:object_r:bt_firmware_file:s0 wait
/dev/block/bootdevice/by-name/dsp        /dsp               ext4    ro,nosuid,nodev,barrier=1                                wait

/dev/block/bootdevice/by-name/boot          /boot           emmc    defaults    defaults
/dev/block/bootdevice/by-name/vendor_boot   /vendor_boot    emmc    defaults    defaults
/dev/block/bootdevice/by-name/recovery      /recovery       emmc    defaults    defaults
/dev/block/bootdevice/by-name/dtbo          /dtbo           emmc    defaults    defaults
/dev/block/bootdevice/by-name/misc          /misc           emmc    defaults    defaults
/dev/block/bootdevice/by-name/super         /super          emmc    defaults    defaults
/dev/block/bootdevice/by-name/vbmeta        /vbmeta         emmc    defaults    defaults
/dev/block/bootdevice/by-name/vbmeta_system /vbmeta_system  emmc    defaults    defaults
/dev/block/bootdevice/by-name/modemst1      /efs1           emmc    defaults    defaults
/dev/block/bootdevice/by-name/modemst2      /efs2           emmc    defaults    defaults
/dev/block/bootdevice/by-name/fsg           /efsg           emmc    defaults    defaults

# Removable storage
/devices/platform/soc/8804000.sdhci/mmc_host*            auto   auto    defaults    voldmanaged=sdcard1:auto,encryptable=footer
/devices/platform/soc/*.ssusb/*.dwc3/xhci-hcd.*.auto*    auto   auto    defaults    voldmanaged=usbotg:auto
