# TWRP-specific flags (merged with recovery.fstab by mount point)
# Partitions that must never be written from recovery (xbl/abl/tz/oeminfo/nvme/
# modem/persist) are either absent or backup-only here.

/system_root    ext4    system          flags=display="System";backup=0;wipeingui=0
/vendor         ext4    vendor          flags=display="Vendor";backup=0;wipeingui=0
/odm            ext4    odm             flags=display="ODM";backup=0;wipeingui=0
/hw_product     ext4    hw_product      flags=display="HW Product";backup=0;wipeingui=0
/cust           ext4    cust            flags=display="Cust";backup=0;wipeingui=0

/boot           emmc    /dev/block/bootdevice/by-name/boot          flags=display="Boot";backup=1;flashimg=1
/vendor_boot    emmc    /dev/block/bootdevice/by-name/vendor_boot   flags=display="Vendor Boot";backup=1;flashimg=1
/recovery       emmc    /dev/block/bootdevice/by-name/recovery      flags=display="Recovery";backup=1;flashimg=1
/dtbo           emmc    /dev/block/bootdevice/by-name/dtbo          flags=display="DTBO";backup=1;flashimg=1
/super          emmc    /dev/block/bootdevice/by-name/super         flags=display="Super";backup=1;flashimg=1
/vbmeta         emmc    /dev/block/bootdevice/by-name/vbmeta        flags=display="VBMeta";backup=1;flashimg=0
/vbmeta_system  emmc    /dev/block/bootdevice/by-name/vbmeta_system flags=display="VBMeta System";backup=1;flashimg=0

/mnt/vendor/persist ext4 /dev/block/bootdevice/by-name/persist      flags=display="Persist";backup=1;wipeingui=0
/firmware       vfat    /dev/block/bootdevice/by-name/modem         flags=display="Firmware";mounttodecrypt;backup=0
/bt_firmware    vfat    /dev/block/bootdevice/by-name/bluetooth     flags=display="BT Firmware";backup=0
/dsp            ext4    /dev/block/bootdevice/by-name/dsp           flags=display="DSP";backup=0

/efs1           emmc    /dev/block/bootdevice/by-name/modemst1      flags=display="EFS";backup=1;flashimg=0;subpartitionof=/efs1
/efs2           emmc    /dev/block/bootdevice/by-name/modemst2      flags=backup=1;subpartitionof=/efs1
/efsg           emmc    /dev/block/bootdevice/by-name/fsg           flags=backup=1;subpartitionof=/efs1

/external_sd    auto    /dev/block/mmcblk1p1 /dev/block/mmcblk1     flags=display="MicroSD";storage;wipeingui;removable
/usb_otg        auto    /dev/block/sdg1 /dev/block/sdg              flags=display="USB OTG";storage;wipeingui;removable
